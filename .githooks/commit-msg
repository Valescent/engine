#!/bin/sh
# Enforce Conventional Commits on every commit message.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Full validation needs cocogitto: cargo install cocogitto --locked

set -e

message_file="$1"
clean=$(mktemp)
trap 'rm -f "$clean"' EXIT

# The message file still contains the comment lines of the commit template;
# they are not part of the message.
grep -v '^#' "$message_file" >"$clean" || true

subject=$(awk 'NF { print; exit }' "$clean")
[ -n "$subject" ] || exit 0

if command -v cog >/dev/null 2>&1; then
	cog verify --ignore-merge-commits --ignore-fixup-commits --file "$clean"
	exit $?
fi

echo "warning: cocogitto (cog) not found, using the built-in check" >&2
echo "         install it with: cargo install cocogitto --locked" >&2

case "$subject" in
"Merge "* | "Revert "* | "fixup!"* | "squash!"* | "amend!"*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" |
	grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
	{
		echo "error: commit subject does not follow Conventional Commits."
		echo "       expected: <type>(<scope>): <description>"
		echo "       types: feat fix docs style refactor perf test build ci chore revert"
		echo "       got: $subject"
	} >&2
	exit 1
fi
